# ═══════════════════════════════════════════════════════════════════════════════
# CORE — Requis au démarrage
# ═══════════════════════════════════════════════════════════════════════════════

# Google Gemini API Key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Modèle conversationnel voix temps réel
ADA_VOICE_MODEL=gemini-3.8-live

# Modèle Gemini utilisé par les sous-agents texte (recherche, tâches, synthèses)
ADA_SUB_MODEL=gemini-2.5-flash

# Token d'authentification Ada (générer: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
# Si défini : exigé sur les endpoints HTTP sensibles ET sur le handshake Socket.IO.
# Vide : pas d'auth token (la restriction d'origine CORS reste active).
ADA_API_TOKEN=your_token_here
VITE_ADA_API_TOKEN=your_token_here

# Origines autorisées pour CORS + Socket.IO (CSV). Vide = défaut sûr
# (Electron + Vite localhost). "*" = tout autoriser (DÉCONSEILLÉ, réouvre la
# faille CSRF/DNS-rebinding où une page web peut piloter le PC).
ADA_ALLOWED_ORIGINS=

# Politique d'exécution shell (safe_exec) :
#  false (défaut) : seules les commandes catastrophiques sont bloquées ;
#                   Jarvis peut agir librement (rm, git, npm…).
#  true (strict)  : les commandes modifiantes initiées par l'IA exigent une
#                   confirmation humaine explicite avant exécution.
# Les blocages durs (fork bomb, rm -rf /, dd disque, pipe réseau→shell,
# shutdown…) s'appliquent TOUJOURS, quel que soit ce réglage.
ADA_SHELL_STRICT=false

# URL du backend Ada
VITE_BACKEND_URL=http://localhost:8000

# Brain biomimétique
BRAIN_ENABLED=false
BRAIN_OBSERVE_ONLY=true
BRAIN_MODULATE_ALL=false

# Vision continue de l'écran
# Attention : consomme rapidement le quota Gemini gratuit si activé.
SCREEN_WATCHER_ENABLED=false
SCREEN_WATCHER_INTERVAL_SEC=15
SCREEN_WATCHER_MAX_BACKOFF_SEC=300

# Audio temps réel
AUTO_START_AUDIO_ON_AUTH=true
ENGINEIO_MAX_DECODE_PACKETS=200
# Durée de silence avant qu'Ada considère la phrase terminée.
# 350 ms privilégie la réactivité ; monter vers 500–700 si elle coupe les pauses.
ADA_VAD_SILENCE_MS=350
# Seuil auxiliaire local (UI/barge-in seulement, Gemini garde son propre VAD).
ADA_VAD_RMS_THRESHOLD=800
# Affiche les transcriptions intermédiaires/finales dans les logs Ada.
ADA_LOG_INPUT_TRANSCRIPTION=true

# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE (Gmail + Calendar + Drive + Sheets + Docs + Maps + YouTube)
# ═══════════════════════════════════════════════════════════════════════════════

# OAuth2 — placer le fichier JSON dans backend/google_credentials.json
# Télécharger depuis Google Cloud Console > APIs & Services > Credentials
# Le token sera généré automatiquement au premier lancement

# Google Maps
GOOGLE_MAPS_API_KEY=

# Brave Search API — moteur web par défaut AdaSearch (remplace Google CSE)
# Créer la clé : https://api.search.brave.com/app/register → plan Free (2000 req/mois)
# Index web indépendant, pas de Custom Search Engine ID, pas de billing GCP requis.
BRAVE_SEARCH_API_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# ID du Google Sheet pour le budget perso
BUDGET_SHEET_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# COMMUNICATION
# ═══════════════════════════════════════════════════════════════════════════════

# Slack — https://api.slack.com/apps > Bot Token (xoxb-...)
SLACK_BOT_TOKEN=

# Telegram — https://t.me/BotFather > /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=  # Ton chat ID perso (obtenir via @userinfobot)

# Seuil texte/vocal (caractères) — réponses > seuil → note vocale OGG
TEXT_VOICE_THRESHOLD=500

# WhatsApp via Evolution API — https://doc.evolution-api.com
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=ada
WHATSAPP_DEFAULT_NUMBER=  # Format: 33612345678

# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTIVITÉ
# ═══════════════════════════════════════════════════════════════════════════════

# Notion — https://www.notion.so/my-integrations
NOTION_TOKEN=

# Linear — https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...  # ou sk_test_ pour les tests

# Qonto — https://app.qonto.com/settings/api
QONTO_LOGIN=               # Format: prenom.nom-XXXX
QONTO_SECRET_KEY=
QONTO_ORGANIZATION_SLUG=   # Identifiant de ton organisation Qonto

# ═══════════════════════════════════════════════════════════════════════════════
# DEV & INFRA
# ═══════════════════════════════════════════════════════════════════════════════

# Supabase — https://app.supabase.com > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key (pas la anon key)

# Vercel — https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=  # Optionnel — pour les comptes Team

# GitHub — https://github.com/settings/tokens (scope: repo, read:user)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO= # Repo par défaut

# Docker — pas de config requise (socket local /var/run/docker.sock)

# Navigateur visible en développement (false = visible si DISPLAY disponible, true = headless)
BROWSER_HEADLESS=true

# ═══════════════════════════════════════════════════════════════════════════════
# SMART HOME & PERSO
# ═══════════════════════════════════════════════════════════════════════════════

# Chromecast — nom exact du Chromecast (laisser vide pour prendre le premier trouvé)
CHROMECAST_NAME=

# Home Assistant — Settings > System > Users > Long-lived token
HOMEASSISTANT_URL=http://192.168.1.100:8123
HOMEASSISTANT_TOKEN=eyJ...

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
SPOTIFY_USERNAME=  # Ton username Spotify

# Apple Health — exporter depuis l'app Health > Profil > Exporter les données
APPLE_HEALTH_EXPORT_PATH=

# ═══════════════════════════════════════════════════════════════════════════════
# CRÉATION & MÉDIAS
# ═══════════════════════════════════════════════════════════════════════════════

# Canva — https://www.canva.com/developers
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=  # OAuth token après autorisation

# Figma — https://www.figma.com/settings > Personal access tokens
FIGMA_ACCESS_TOKEN=figd_...

# ElevenLabs — https://elevenlabs.io/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=  # ID de la voix par défaut (ex: voix custom Jarvis)

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# ═══════════════════════════════════════════════════════════════════════════════
# VISION OBJET (YOLO + Open Images V7)
# ═══════════════════════════════════════════════════════════════════════════════

# Master switch : false = aucun import, zéro impact
VISION_OBJECT_ENABLED=false

# Modèle YOLO (téléchargé automatiquement au premier boot par ultralytics)
VISION_OBJECT_MODEL=yolov8m-oiv7.pt

# Device : 'mps' (Mac M-series), 'cuda' (Hetzner GPU), 'cpu' (fallback)
VISION_OBJECT_DEVICE=mps

# Tempo de la boucle caméra (frames/sec)
VISION_OBJECT_FPS=10

# Confidence minimale pour considérer une détection
VISION_OBJECT_CONFIDENCE=0.45

# Throttling brain : intervalle min entre 2 events de la même classe
VISION_OBJECT_BRAIN_THROTTLE_SEC=1.0

# Cap maximal d'events brain envoyés par seconde
VISION_OBJECT_MAX_EVENTS_PER_SEC=10

# Retention SQLite + ChromaDB (jours)
VISION_OBJECT_RETENTION_DAYS=30

# Heure du cleanup nocturne (HH:MM)
VISION_OBJECT_CLEANUP_TIME=04:00

# Boucle caméra activée (false = mode PULL seul)
VISION_OBJECT_CAMERA_LOOP=true

# Boucle écran activée (greffée sur screen_watcher)
VISION_OBJECT_SCREEN_LOOP=true

# ═══════════════════════════════════════════════════════════
# Brain v3 — couche neurobiologique en surcouche
# ═══════════════════════════════════════════════════════════

# ─── Master switches ───────────────────────────
BRAIN_V3_ENABLED=false                 # par défaut OFF — activer après calibration shadow
BRAIN_V3_SHADOW_MODE=true              # true = v3 logge sans décider, false = v3 prend la main

# ─── Performance ───────────────────────────────
BRAIN_V3_TICK_BUDGET_MS=3.0            # budget temps par tick avant degraded

# ─── Neurones adaptatifs (AdaptiveLIF) ─────────
BRAIN_V3_AHP_AMPLITUDE=0.15            # after-hyperpolarization post-spike
BRAIN_V3_AHP_DECAY=0.92                # decay AHP par tick
BRAIN_V3_THRESHOLD_DRIFT=0.005         # vitesse d'adaptation du seuil
BRAIN_V3_THRESHOLD_MIN=0.40            # plancher du seuil adaptatif
BRAIN_V3_THRESHOLD_MAX=2.00            # plafond du seuil adaptatif

# ─── Refractory adaptatif par canal ────────────
BRAIN_V3_REFRACTORY_VISION_OBJECT=2.0  # YOLO : 2s entre spikes même classe
BRAIN_V3_REFRACTORY_VISION_SCENE=8.0   # Gemini multimodal : long car coûteux
BRAIN_V3_REFRACTORY_FACE_MOTION=1.0    # MediaPipe : court (continu)
BRAIN_V3_REFRACTORY_AUDIO=0.5          # voix : très réactif
BRAIN_V3_REFRACTORY_TEXT=0.3           # texte : très réactif

# ─── Habituation ───────────────────────────────
BRAIN_V3_HABITUATION_HALFLIFE=120.0    # secondes pour qu'une familiarité décroisse de 50%
BRAIN_V3_HABITUATION_MAX_KEYS=256      # LRU cap
BRAIN_V3_HABITUATION_GAIN=0.70         # familiarité=1 → intensité réduite à 30%

# ─── Inhibition latérale ───────────────────────
BRAIN_V3_INHIBITION_STRENGTH=0.3       # un canal qui vient de spike inhibe les autres de 0.3

# ─── Budget d'attention ────────────────────────
BRAIN_V3_ATTENTION_BUDGET_INIT=1.0     # 1 réaction normale dispo au démarrage
BRAIN_V3_ATTENTION_BUDGET_MAX=1.5      # plafond
BRAIN_V3_COST_OBJECT_NORMAL=0.20       # coût YOLO normal
BRAIN_V3_COST_SCENE_NORMAL=0.30        # coût scène Gemini (plus cher)
BRAIN_V3_COST_HIGH_RISK=0.05           # urgences quasi gratuites

# ─── Politique de réaction ─────────────────────
BRAIN_V3_REACTION_THRESHOLD=0.55       # saillance min pour autoriser REACT
BRAIN_V3_PROB_GATE_SLOPE=2.0           # pente probabilité au-dessus du seuil

# ─── Neuromodulation (hormones v2 → modulation v3) ─
BRAIN_V3_CORTISOL_THRESHOLD_GAIN=0.40  # stress haut → seuils baissent jusqu'à 40%
BRAIN_V3_FATIGUE_DECAY_GAIN=0.50       # fatigue → oubli x1.5
BRAIN_V3_DOPAMINE_REFILL_GAIN=0.0008   # dopamine alimente le budget

# Racine du projet (chemin ABSOLU réel — le projet vit sur le disque externe).
# Sans cette variable, plusieurs agents retombent sur un défaut mort (/Users/bryandev/jarvis).
JARVIS_ROOT=/Volumes/Disque dev/Archives-Mars-Avril-2026/jarvis

# ── Contrôle PC (os_control_agent) ───────────────────────────────────────────
# Animation « comme Claude » : curseur qui glisse + frappe caractère par caractère.
OS_CONTROL_ANIMATE=true
OS_CONTROL_ANIM_DURATION=0.45      # durée du glissement du curseur (secondes)
OS_CONTROL_TYPE_CPS=22             # vitesse de frappe animée (caractères/seconde)
OS_CONTROL_TYPE_MAX_ANIM=120       # au-delà de N caractères → collage (cmd+V)
# Mode de contrôle : "plan" (rafale planifiée, défaut, le plus fiable) ou
# "step" (observe→agis→ré-observe à chaque action, comportement le plus proche de Claude).
OS_CONTROL_MODE=plan
OS_CONTROL_MAX_STEPS=20            # plafond d'étapes en mode step
OS_CONTROL_STEP_TIMEOUT_SEC=150    # timeout global en mode step (plus d'appels modèle)

# ── Gate de sécurité (security_gate) ─────────────────────────────────────────
# Mode "audit" (défaut) : autonome, journalise tout + bloque le catastrophique,
# sans confirmation. "approve" : renvoie une décision à valider (non câblé).
JARVIS_GATE_MODE=audit
JARVIS_AUDIT_KEY=change-moi-cle-locale-audit   # clé HMAC du journal chaîné
# Filtres Gemini permissifs (vocabulaire libre) — OFF par défaut car peut casser
# la connexion voix selon la version du SDK. N'active qu'après test.
JARVIS_PERMISSIVE_SAFETY=false
# JARVIS_GATE_DIR=backend/memory/gate          # emplacement journal + kill switch

# ── Reprompting (reprompt) ───────────────────────────────────────────────────
JARVIS_REPROMPT=false                # true = reformule les demandes texte avant le LLM (ajoute un appel Gemini)
JARVIS_REPROMPT_MODEL=gemini-2.5-flash
JARVIS_REPROMPT_MIN_LEN=12           # en dessous de N caractères → pas de reformulation

# ── Visage vivant (vignette) ─────────────────────────────────────────────────
# Diffuse l'état émotionnel du brain (get_affect_snapshot) sur le socket
# `ada_affect` → le visage d'Ada affiche sa vraie humeur. Défensif : brain off → rien.
JARVIS_AFFECT_BROADCAST=true         # false = ne pas diffuser l'humeur au frontend
JARVIS_AFFECT_INTERVAL=1.5           # secondes entre deux vérifications d'humeur

# ── Cerveau hybride (llm_router) ─────────────────────────────────────────────
# Raisonnement / codage sur Claude quand dispo, repli Gemini. Voix = Gemini Live.
JARVIS_BRAIN=hybrid                  # hybrid | claude | claudecli | gemini
# ── Cerveau Claude GRATUIT via Claude Code CLI (abonnement, pas de clé API) ──
# En hybrid, si ANTHROPIC_API_KEY est VIDE et que Claude Code est installé,
# Ada utilise automatiquement `claude -p` (ton abonnement) → gratuit.
# Pour le forcer : JARVIS_BRAIN=claudecli
JARVIS_CLAUDECLI_BIN=claude          # binaire Claude Code (chemin si besoin)
# JARVIS_CLAUDECLI_MODEL=            # optionnel (sinon modèle par défaut du CLI)
JARVIS_CLAUDECLI_TIMEOUT=120
# ── OU cerveau Claude via API Anthropic (payant au token) ──
# ANTHROPIC_API_KEY=                 # requis seulement pour la voie API
JARVIS_CLAUDE_MODEL=claude-sonnet-4-5
JARVIS_GEMINI_TEXT_MODEL=gemini-2.5-flash
# ── Agent de codage autonome (dev_agent) ─────────────────────────────────────
DEV_AGENT_MAX_STEPS=40
# Génération vidéo/animation (outil generate_video) : modèle Replicate à utiliser
# REPLICATE_VIDEO_MODEL=

# ── Frontend / Mobile (PWA) ──────────────────────────────────────────────────
# URL du backend pour forcer une cible distante (tunnel séparé, tests, etc.).
# Laisse vide : Electron/Vite local utilisent localhost:8000 et la build web
# utilise automatiquement son origine HTTPS courante (Tailscale/Cloudflare).
# VITE_BACKEND_URL=https://ada.ton-tunnel.exemple
# Doit correspondre à ADA_API_TOKEN pour sécuriser l'accès distant :
# VITE_ADA_API_TOKEN=
